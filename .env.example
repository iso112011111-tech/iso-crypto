# ไม่ต้องตั้งอะไรเลยถ้ารันในเครื่อง (ข้อมูลผู้ใช้เก็บใน .data/)
#
# Upstash (ไม่บังคับ): เก็บประวัติคำตัดสินของ AI ตอนขึ้นออนไลน์ (Vercel เก็บไฟล์ถาวรไม่ได้)
# จาก https://console.upstash.com → สร้าง Redis database → แท็บ REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- AI (ผู้ช่วย iso AI) ----------
# endpoint แบบ OpenAI-compatible (/v1/chat/completions) และคีย์ — ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น
AI_BASE_URL=
AI_API_KEY=
# AI ใช้ได้เฉพาะสมาชิกที่ล็อกอิน (ค่าเริ่มต้น) · ตั้ง 0 เพื่อปิดการบังคับล็อกอินตอนทดสอบในเครื่องเท่านั้น
# AI_REQUIRE_LOGIN=0

# ---------- Firebase (สมาชิก + ฐานข้อมูลผู้ใช้) ----------
# จาก Firebase Console → Project settings → Your apps → Web app (ค่าพวกนี้เปิดเผยได้)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------- แจ้งเตือนเข้ามือถือ (Web Push) ----------
# สร้างด้วย: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# รหัสสำหรับเรียกงานตามรอบ /api/cron (ตรวจแจ้งเตือน + จับเหรียญใหม่) ทุก 1 นาที
# สร้างด้วย: openssl rand -hex 24
CRON_SECRET=
# พอร์ตที่รันในเครื่อง (ให้ตัวตั้งเวลาเบื้องหลังเรียกถูกที่)
LOCAL_PORT=3150
